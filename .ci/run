#!/usr/bin/zsh -feu

# Try to build with different compilers, for Xorg?
# run tests, and invoke `cppcheck' and `run-clang-tidy'

set -ue

gitdir=$(git rev-parse --show-toplevel)

# needs:
# ai libclang-rt-21-dev
# ai clang
# clang-tidy cppcheck

# useless:
# ai libc++-21-dev
# ai libc++abi-21-dev
# ai libc++1



# Do the builds & run tests. On Linux.
# Runs inside the .git directory where THIS script is located.

gitdir=$(cd $(dirname $0); git rev-parse --show-toplevel)
INVOKE_INSTALL=no
# $gitdir/
BUILD_DIR=build
# 2 levels

while getopts :i OPT; do
    case $OPT in
        i|+i)
            INVOKE_INSTALL=yes
            ;;
        *)
            echo "usage: ${0##*/} [+-i] [--] ARGS..."
            exit 2
    esac
done
shift $(( OPTIND - 1 ))
OPTIND=1


build_run_tests()
{
    set -e
    local dir=$1
    # ninja -v && echo $? &&
    cmake --build $dir &&
        { find -name \*.gcda -exec rm -v {} \; ; cd $dir/test; ctest }
}


build_with_compiler() {
    local compiler="$1"
    local dir

    set -eu
    mkdir -p ${dir:=$BUILD_DIR/$compiler}

    cecho blue "building with $compiler in $dir"

    # todo don't cd, but -B $dir
    cmake -DCMAKE_COLOR_DIAGNOSTICS=ON \
          -DCMAKE_BUILD_TYPE=Debug -G Ninja \
          -DFORCE_COLORED_OUTPUT=1 -DCMAKE_CXX_COMPILER=$compiler  \
          -B $dir
    # &&
    # changes dir:
    ( build_run_tests $dir )

    set -x
    # another static analysis:
    cppcheck --project=$dir/compile_commands.json \
                 --enable=all \
                 --suppress=missingIncludeSystem \
                 --suppress=preprocessorErrorDirective \
                 --suppress=knownArgument \
                 --suppress=missingInclude \
                 --suppress=unusedStructMember:test/test-machine.cpp \
                 --library=googletest
}

##
build_with_compiler "g++"

build_with_compiler "clang++"
set -x
# analysis
run-clang-tidy -checks="clang-analyzer-\*,-clang-diagnostic-vla-cxx-extension" || : ignore


# fixme:
rm -f $BUILD_DIR/clang++/**/*gcda


## Install
if [[ $INVOKE_INSTALL == yes ]]
then
( cd $gitdir
  tmpdir=$gitdir/tmp
  # cmake install --install . --prefix tmp -v
  pushd build.gcc
  DESTDIR=$tmpdir cmake --install .   -v
  DESTDIR=$tmpdir ninja -v install
)
fi
